    "SystemPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "system_type",
        "state"
      ],
      "properties": {
        "system_type": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "LINK_STATUS",
            "TIME_STATUS",
            "SCHEMA_VIOLATION",
            "TASK_ACK"
          ]
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
